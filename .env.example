# Copy to .env.local only for local development. Never commit real values.

# Dedicated Neon Postgres for this Vercel project. Leave unset for storage-offline local dev.
DATABASE_URL=

# Local-only guest cookie signing secret. Production and Preview use Vercel env.
AUTH_SECRET=replace-with-a-local-dev-secret

# Optional Web Push release notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=support@randroid.dev
NOTIFICATION_ADMIN_TOKEN=

# Optional Clerk Google sign-in. Do not set until the Clerk provider is wired.
# Publishable keys start with pk_test_ or pk_live_. Secret keys start with sk_test_ or sk_live_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
# Must stay unset for the first release. /sign-in is the single sign-in-or-up page.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=
# Must stay unset. Clerk force redirects bypass account handoff tokens.
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=
CLERK_SIGN_IN_FORCE_REDIRECT_URL=
CLERK_SIGN_UP_FORCE_REDIRECT_URL=
# Deprecated by Clerk for new apps. Must stay unset.
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=
CLERK_AFTER_SIGN_IN_URL=
CLERK_AFTER_SIGN_UP_URL=
